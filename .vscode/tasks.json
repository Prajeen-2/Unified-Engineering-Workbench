{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build All (Release)",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\build.bat"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run Packaged Launch.exe",
            "type": "shell",
            "command": "cmd.exe",
            "args": [
                "/c",
                "${workspaceFolder}\\Launch.exe"
            ],
            "problemMatcher": []
        }
    ]
}

